# The app stores all user data in the browser (localStorage) and needs no
# database credentials. Every variable below is optional — without them the
# chart engine still works; only the AI-backed endpoints go dark.

# Server-only. Do not rename this to NEXT_PUBLIC_*.
# Required for palm-image analysis (/api/palm-reading).
OPENAI_API_KEY=
# Required for the chart question endpoint.
ANTHROPIC_API_KEY=
# Optional alias if your deployment already names the Claude key this way.
CLAUDE_API_KEY=
# Optional Claude model override for the one-time chart question endpoint.
CLAUDE_MODEL=

# Optional: Path to Swiss Ephemeris data files for higher precision
# If not set, uses built-in Moshier ephemeris (lower precision but works without data files)
# EPHEMERIS_PATH=/path/to/ephe

# Server-only Neon Postgres connections. Never prefix these with NEXT_PUBLIC_.
# Use the pooled URL for application queries.
DATABASE_URL=
# Use the direct, non-pooler URL for Drizzle migrations.
DATABASE_URL_UNPOOLED=

# Signs the anonymous device-id cookie (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_ID_SECRET=

# Google sign-in. From Google Cloud Console -> Credentials -> OAuth 2.0 Client ID
# (type: Web application). The client secret is a real secret; the id is not,
# but neither belongs in NEXT_PUBLIC_.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The canonical origin this app is reached on, no trailing slash.
# OAuth redirect URIs must match Google's registered value byte for byte, so
# this is config rather than something derived from the incoming request --
# a Host header is attacker-controlled and must never build a redirect URI.
#   dev:  http://localhost:7001
#   prod: https://your-domain
APP_ORIGIN=http://localhost:7001
