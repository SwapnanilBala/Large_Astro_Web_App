NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional canonical public origin for OAuth redirects, e.g. https://your-app.vercel.app
# If omitted, the current browser origin is used.
NEXT_PUBLIC_SITE_URL=

# Server-only. Do not rename this to NEXT_PUBLIC_*.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required for persistent one-hour follow-up question cooldown tracking.
SUPABASE_SERVICE_ROLE_KEY=
# Optional salt for hashing IP/chart usage identifiers before storage.
QUESTION_USAGE_HASH_SALT=
# Optional alias if your deployment already names the Claude key this way.
CLAUDE_API_KEY=
# Optional Claude model override for the one-time chart question endpoint.
CLAUDE_MODEL=

# Optional: Path to Swiss Ephemeris data files for higher precision
# If not set, uses built-in Moshier ephemeris (lower precision but works without data files)
# EPHEMERIS_PATH=/path/to/ephe
